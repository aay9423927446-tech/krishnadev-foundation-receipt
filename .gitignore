cat > .gitignore <<'EOF'
# Dependencies
node_modules/

# Vite build
dist/
dist-ssr/

# Electron build
release/

# Local generated receipt PDFs
Receipt pdfs/

# Local databases
*.db
*.sqlite
*.sqlite3

# Environment files
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS files
.DS_Store

# IDE
.vscode/
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
EOF